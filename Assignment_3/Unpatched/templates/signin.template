<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <title>Squeak!</title>
  <link rel="stylesheet" href="/css/bootstrap.min.css">
  <link rel="stylesheet" href="/css/app.css">
</head>
<body>
  <nav class="navbar navbar-light bg-light justify-content-between">
    <span class="navbar-brand mb-0 h1">Squeak!</span>
    <form id="signin-form" class="form-inline">
      <input id="signin-username" type="text" class="form-control mr-1" placeholder="Name">
      <input id="signin-password" type="password" class="form-control mr-1" placeholder="Password">
      <button type="submit" class="btn btn-primary">Sign in</button>
    </form>
  </nav>

  <div class="container mt-5">
    <h4>Sign up to Squeak!</h4>
    <form id="signup-form" style="max-width: 320px;">
      <div class="form-group">
        <input id="signup-username" type="text" class="form-control" placeholder="Name">
        <small id="signup-username-error" class="text-danger"></small>
      </div>
      <div class="form-group">
        <input id="signup-password" type="password" class="form-control" placeholder="Password">
        <small id="signup-password-error" class="text-danger"></small>
      </div>
      <button type="submit" class="btn btn-primary">Sign up!</button>
    </form>
  </div>

  <script src="/js/main.js"></script>
</body>
</html>
